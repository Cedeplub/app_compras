DO|CHECK_SUCESSAO|F=IF(COUNTIF(dSucessao!$B$3:$B$300,$A2)+COUNTIF(dSucessao!$D$3:$D$300,$A2)>0,"VERIFICAR SUCESSAO","")|V=None
DP|NIVEL_BASE_MARGEM_VAREJO|F=IF($CZ2="",0,IF($CZ2<0,3,IF($CZ2<Parametros!$B$22,2,IF($CZ2<Parametros!$B$21,1,0))))|V=0
DQ|NIVEL_MARGEM_VAREJO|F=IF(AND($AX2<>"A",$DP2>0),MIN($DP2+1,3),$DP2)|V=0
DR|CRED_TOTAL_EMPIRICO|F=IF(OR($BH2=0,$BI2=0),"",MAX(0,1-$BI2/$BH2))|V=None
