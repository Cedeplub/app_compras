# Copie para .env e preencha. Nenhuma credencial tem valor padrao no config.py:
# faltou aqui, o app avisa e nao sobe (ver app/config.py).

# ---- Oracle (schema COMPRAS, unico schema que o app enxerga) ----
ORA_USER=compras
ORA_PASSWORD=
ORA_DSN=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=192.168.0.98)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=WINT)))
ORA_SCHEMA=COMPRAS

# Modo thick e obrigatorio neste servidor (verificador de senha legado 0x939).
ORA_CLIENT_DIR=C:\Oracle\instantclient_21_17

# Limite de conexoes do pool e de execucoes simultaneas.
ORA_POOL_MAX=4
APP_MAX_EXEC=3
APP_TIMEOUT_SEGUNDOS=30

# ---- HTTP ----
APP_HOST=0.0.0.0
APP_PORT=8020

# Cookie de sessao. secure=1 exige HTTPS; rede interna ainda e HTTP.
APP_COOKIE_SECURE=0
APP_SESSAO_HORAS=12

# Paginacao da tela de decisao de compra
APP_ITENS_POR_PAGINA=50
